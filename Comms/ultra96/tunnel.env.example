MODE=reverse

# SSH jump host (reachable from Ultra96)
TUNNEL_USER=xilinx
TUNNEL_HOST=makerslab-fpga-33.ddns.comp.nus.edu.sg
TUNNEL_PORT=22

# Forward mode: local port on Ultra96 -> remote broker
LOCAL_PORT=8883
BROKER_HOST=localhost
BROKER_PORT=8883

# Reverse mode: open a port on the SSH server that forwards to a target reachable
# from the machine running this script. Leave these as localhost:8883 to proxy
# to a broker on your laptop, or point them at your EC2 broker instead.
REVERSE_TARGET_HOST=18.140.9.0
REVERSE_TARGET_PORT=8883
REMOTE_BIND_ADDR=127.0.0.1
REMOTE_PORT=18883

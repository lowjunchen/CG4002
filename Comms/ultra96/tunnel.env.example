MODE=reverse

# SSH jump host (reachable from Ultra96)
TUNNEL_USER=xilinx
TUNNEL_HOST=makerslab-fpga-33.ddns.comp.nus.edu.sg
TUNNEL_PORT=22

# Forward mode: local port on Ultra96 -> remote broker
LOCAL_PORT=8883
BROKER_HOST=localhost
BROKER_PORT=8883

# Reverse mode: open a port on jump host that forwards to Ultra96 local broker
REMOTE_BIND_ADDR=127.0.0.1
REMOTE_PORT=18883

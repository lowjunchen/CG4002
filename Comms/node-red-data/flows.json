    {
        "id": "a75b614833852708",
        "type": "function",
        "z": "73544b573df69959",
        "name": "function 1",
        "func": "let devices = global.get(\"devices\") || {};\n\nconst TIMEOUT = 4000; // ms → if no update within this → treat as disconnected\nlet now = Date.now();\n\n// -------- Save incoming data --------\nif (msg.payload && msg.payload.type) {\n    devices[msg.payload.type] = {\n        ...msg.payload,\n        _ts: now   // timestamp for timeout handling\n    };\n}\n\nglobal.set(\"devices\", devices);\n\n// -------- Helper --------\nfunction valid(d) {\n    return d && (now - d._ts) < TIMEOUT;\n}\n\n// -------- Get Devices --------\nlet headset = valid(devices[\"headset\"]) ? devices[\"headset\"] : null;\nlet rightGlove = valid(devices[\"right glove\"]) ? devices[\"right glove\"] : null;\nlet leftGlove = valid(devices[\"left glove\"]) ? devices[\"left glove\"] : null;\n\n// -------- BPM Average --------\nlet bpmSum = 0;\nlet bpmCount = 0;\n\nif (rightGlove && rightGlove.bpm > 0) { bpmSum += rightGlove.bpm; bpmCount++; }\nif (leftGlove && leftGlove.bpm > 0) { bpmSum += leftGlove.bpm; bpmCount++; }\n\n// -------- Output --------\nmsg.payload = {\n    \"Worn\": headset ? (headset.movement ? 1 : 0) : 0,\n    \"H Bat\": headset ? headset.percent || 0 : 0,\n    \"Mic\": headset ? headset.p2p || 0 : 0,\n\n    \"Tier\": Math.max(\n        rightGlove ? rightGlove.Tier || 0 : 0,\n        leftGlove ? leftGlove.Tier || 0 : 0\n    ),\n\n    \"R Bat\": rightGlove ? rightGlove.percent || 0 : 0,\n    \"L Bat\": leftGlove ? leftGlove.percent || 0 : 0,\n\n    \"BPM\": bpmCount ? Math.round(bpmSum / bpmCount) : 0,\n\n    \"A\": Math.max(\n        rightGlove ? rightGlove.BPMAlert || 0 : 0,\n        leftGlove ? leftGlove.BPMAlert || 0 : 0\n    )\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 220,
        "wires": [
            [
                "0d13a5c474080a2e"
            ]
        ]
    },

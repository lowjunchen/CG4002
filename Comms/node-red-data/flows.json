    {
        "id": "5599c601218c9687",
        "type": "function",
        "z": "73544b573df69959",
        "name": "Toggle Broker Tabs",
        "func": "const hive = msg.payload?.hivemq;\nconst mosq = msg.payload?.mosquitto;\n\nif (!hive || !mosq) {\n    node.warn(\"Missing flow info from admin API\");\n    return null;\n}\n\nconst enableHive = !!hive.disabled;\nhive.disabled = !enableHive;\nmosq.disabled = enableHive;\n\nconst active = enableHive ? \"HiveMQ\" : \"Mosquitto\";\n\nconst hiveMsg = {\n    topic: \"hivemq\",\n    payload: hive,\n    headers: { \"Content-Type\": \"application/json\" }\n};\n\nconst mosqMsg = {\n    topic: \"mosquitto\",\n    payload: mosq,\n    headers: { \"Content-Type\": \"application/json\" }\n};\n\nconst statusMsg = { payload: active };\n\nreturn [hiveMsg, mosqMsg, statusMsg];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
